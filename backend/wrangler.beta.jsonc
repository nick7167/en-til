// TestFlight only: development enables the unapproved draft catalogue and Apple sandbox.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "en-til-beta",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "development",
    "DISABLED": "false",
    "APPLE_BUNDLE_ID": "dev.adrez.entil",
    "APPLE_APP_ID": "6814572975"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomObject"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "en-til-beta",
      "database_id": "914d1961-084d-4598-ac54-fe62a9855a3d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ENTRY_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "head_sampling_rate": 0.1
  },
  "account_id": "02a5e41437c57f2410c3f930f8fb02ae"
}
