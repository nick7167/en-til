{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "en-til-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "ENVIRONMENT": "development", "DISABLED": "false" },
  "durable_objects": {"bindings": [{"name":"ROOMS","class_name":"RoomObject"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["RoomObject"]}],
  "d1_databases": [{"binding":"DB","database_name":"en-til-local","database_id":"local-only","migrations_dir":"migrations"}],
  "ratelimits": [{"name":"ENTRY_LIMIT","namespace_id":"1001","simple":{"limit":30,"period":60}}],
  "observability": {"enabled":true,"logs":{"enabled":true,"invocation_logs":false},"head_sampling_rate":0.1}
}
